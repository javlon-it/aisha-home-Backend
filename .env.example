NODE_ENV=development
PORT=5000
# Lokal development uchun; production'da server 0.0.0.0 da tinglaydi.
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Maxfiy qiymatlarni faqat server muhitiga kiriting.
MONGODB_URI=
MONGODB_DB_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production admin proxy: 32 random bytes encoded as 64 hex characters; keep secret.
ADMIN_PROXY_SECRET=
# Single-process order attempts per transport IP; proxy setup must be reviewed before deploy.
ORDER_RATE_LIMIT_WINDOW_MS=600000
ORDER_RATE_LIMIT_MAX=30
ORDER_RATE_LIMIT_MAX_KEYS=10000
